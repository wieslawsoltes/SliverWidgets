<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SliverWidgets.MauiGallery</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationTitle>SliverWidgets MAUI Gallery</ApplicationTitle>
    <ApplicationId>io.github.wieslawsoltes.sliverwidgets.mauigallery</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SliverWidgets.Core\SliverWidgets.Core.csproj" />
    <ProjectReference Include="..\..\src\SliverWidgets.Maui\SliverWidgets.Maui.csproj" />
    <ProjectReference Include="..\SliverWidgets.GalleryData\SliverWidgets.GalleryData.csproj" />
  </ItemGroup>

</Project>
