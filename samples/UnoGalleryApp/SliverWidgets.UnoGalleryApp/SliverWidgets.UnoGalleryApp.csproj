<Project Sdk="Uno.Sdk/6.5.36">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>SliverWidgets Uno Gallery</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>io.github.wieslawsoltes.sliverwidgets.unogallery</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Wieslaw Soltes</ApplicationPublisher>
    <!-- Package description -->
    <Description>SliverWidgets Uno desktop gallery for high-performance sliver layouts.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      CSharpMarkup;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UnoGallery\SliverWidgets.UnoGallery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Uno.WinUI" />
  </ItemGroup>

</Project>
