<Window
    x:Class="AvaloniaGallery.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvaloniaGallery"
    xmlns:slivers="using:SliverWidgets.Avalonia"
    Title="SliverWidgets Avalonia Gallery"
    Width="1180"
    Height="780"
    MinWidth="980"
    MinHeight="680"
    Background="#F4F7FB">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E0EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.viewport">
      <Setter Property="Background" Value="#E9EEF6" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.row-card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E0EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.tile-card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E0EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border
        Padding="20,16"
        Background="#FFFFFF"
        BorderBrush="#D8E0EC"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="SliverWidgets Avalonia Gallery" />
          <TextBlock Classes="muted" Text="Unified Flutter-inspired sliver scenario catalog using native Avalonia controls." />
        </StackPanel>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding Metrics}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border
                  MinWidth="132"
                  Padding="10"
                  Background="#F8FAFC"
                  BorderBrush="{Binding AccentColor}"
                  BorderThickness="2,0,0,0"
                  CornerRadius="6">
                <StackPanel>
                  <TextBlock Classes="muted" Text="{Binding Label}" />
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Value}" />
                  <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <TabControl x:Name="GalleryTabs" Grid.Row="1" Margin="16">
      <TabItem Header="Fixed">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Fixed large list" />
              <TextBlock Classes="muted" Text="100,000 uniform rows keep index-to-offset mapping arithmetic while preserving native ScrollViewer input." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Item extent" />
              <Slider Minimum="40" Maximum="92" Value="{Binding FixedItemExtent, Mode=TwoWay}" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding FixedRows}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <slivers:SliverVirtualizingStackPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        ItemExtent="{Binding $parent[Window].DataContext.FixedItemExtent}"
                        Spacing="8" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="row-card">
                      <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                        <Border Background="{Binding AccentColor}" CornerRadius="3" />
                        <StackPanel Grid.Column="1">
                          <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Classes="muted" Text="{Binding Subtitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Text="{Binding Rank}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Variable">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Variable and non-uniform list" />
              <TextBlock Classes="muted" Text="Rows report measured heights from the item template while the panel estimates unobserved extents." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Estimated extent" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="76 px" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding VariableRows}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <slivers:SliverVirtualizingListPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        EstimatedItemExtent="76"
                        Spacing="8" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Height="{Binding Extent}" Classes="row-card">
                      <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                        <Border Background="{Binding AccentColor}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#475569" Text="{Binding Category}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Stack">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Variable stack layout" />
              <TextBlock Classes="muted" Text="100,000 non-uniform cards keep linear stack offsets while each card gets its own width and height." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Height range" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="52-128 px" />
              <TextBlock Classes="muted" Text="Width range" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="160-640 px" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding StackItems}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <slivers:SliverVirtualizingStackLayoutPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        CrossAxisAlignment="Center"
                        MaxItemCrossAxisExtent="640"
                        MaxItemMainAxisExtent="128"
                        MinItemCrossAxisExtent="160"
                        MinItemMainAxisExtent="52"
                        Spacing="8" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="row-card">
                      <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                        <Border Background="{Binding AccentColor}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="NoWrap" />
                          <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#475569" Text="{Binding Rank}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Grid">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Adaptive grid" />
              <TextBlock Classes="muted" Text="Max cross-axis extent sizing adapts column count as the viewport width changes." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding GridItems}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <slivers:SliverVirtualizingGridPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        ChildAspectRatio="1.55"
                        CrossAxisSpacing="12"
                        MainAxisSpacing="12"
                        MaxCrossAxisExtent="220"
                        SizingMode="MaxCrossAxisExtent" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="tile-card">
                      <Grid RowDefinitions="Auto,*,Auto">
                        <Border Width="32" Height="4" HorizontalAlignment="Left" Background="{Binding AccentColor}" CornerRadius="2" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                          <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Category}" />
                          <TextBlock Classes="muted" Text="{Binding Title}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Foreground="#475569" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Wrap">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Variable wrap layout" />
              <TextBlock Classes="muted" Text="100,000 non-uniform chips pack into wrap lines using deterministic width and height extents." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Height range" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="72-150 px" />
              <TextBlock Classes="muted" Text="Width range" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="120-280 px" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding WrapItems}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <slivers:SliverVirtualizingWrapPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        CrossAxisSpacing="10"
                        MainAxisSpacing="10"
                        MaxItemCrossAxisExtent="280"
                        MaxItemMainAxisExtent="150"
                        MinItemCrossAxisExtent="120"
                        MinItemMainAxisExtent="72" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="tile-card">
                      <Grid RowDefinitions="Auto,*,Auto">
                        <Border Width="28" Height="4" HorizontalAlignment="Left" Background="{Binding AccentColor}" CornerRadius="2" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" Text="{Binding Category}" TextWrapping="NoWrap" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Header">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Pinned collapsible header" />
              <TextBlock Classes="muted" Text="The app-bar header follows the list scrollbar and shrinks between max and min extents." TextWrapping="Wrap" />
              <CheckBox Content="Pinned" IsChecked="{Binding HeaderPinned, Mode=TwoWay}" />
              <TextBlock Classes="muted" Text="Shared cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <Grid RowDefinitions="Auto,*">
              <slivers:SliverPersistentHeader
                  MaxExtent="160"
                  MinExtent="56"
                  Pinned="{Binding HeaderPinned}"
                  ScrollOffset="{Binding #HeaderScrollViewer.Offset.Y}">
                <Border Padding="18,10" Background="#0F172A" ClipToBounds="True" CornerRadius="8">
                  <StackPanel Spacing="2">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Text="Persistent Header" />
                    <TextBlock FontSize="12" Foreground="#CBD5E1" Text="Pinned collapse behavior driven by SliverPersistentHeaderLayout." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </slivers:SliverPersistentHeader>

              <ScrollViewer x:Name="HeaderScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding PreviewRows}">
                  <slivers:SliverItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <slivers:SliverStackPanel
                          CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                          ItemExtent="54"
                          Spacing="6" />
                    </ItemsPanelTemplate>
                  </slivers:SliverItemsControl.ItemsPanel>
                  <slivers:SliverItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="row-card">
                        <TextBlock Foreground="#0F172A" Text="{Binding Subtitle}" />
                      </Border>
                    </DataTemplate>
                  </slivers:SliverItemsControl.ItemTemplate>
                </slivers:SliverItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Tabs">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Tabbed nested scroll" />
              <TextBlock Classes="muted" Text="Flutter projects commonly pair NestedScrollView, SliverAppBar, TabBar, and SliverOverlapAbsorber/Injector so each tab has its own scroll body without sliding under the header." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Avalonia projection" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Native TabControl" />
              <TextBlock Classes="muted" Text="Each tab hosts a sliver-backed ScrollViewer. The header and tabs stay outside the inner scroll body, mirroring the overlap coordination concept." TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="18,12" Background="#1E3A8A" CornerRadius="8,8,0,0">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Text="NestedScrollView-style catalog" />
                  <TextBlock FontSize="12" Foreground="#DBEAFE" Text="Pinned app header plus tabbed inner scroll bodies." TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TabControl Grid.Row="1" Margin="8">
                <TabItem Header="Results">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding PreviewRows}">
                      <slivers:SliverItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <slivers:SliverStackPanel
                              CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                              ItemExtent="58"
                              Spacing="6" />
                        </ItemsPanelTemplate>
                      </slivers:SliverItemsControl.ItemsPanel>
                      <slivers:SliverItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="row-card">
                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                              <Border Background="{Binding AccentColor}" CornerRadius="3" />
                              <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                                <TextBlock Classes="muted" Text="{Binding Subtitle}" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" Text="{Binding Category}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </slivers:SliverItemsControl.ItemTemplate>
                    </slivers:SliverItemsControl>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Saved">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding VariableRows}">
                      <slivers:SliverItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <slivers:SliverVirtualizingListPanel
                              CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                              EstimatedItemExtent="76"
                              Spacing="8" />
                        </ItemsPanelTemplate>
                      </slivers:SliverItemsControl.ItemsPanel>
                      <slivers:SliverItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="{Binding Extent}" Classes="row-card">
                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                              <Border Background="{Binding AccentColor}" CornerRadius="3" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                                <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" Text="{Binding Rank}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </slivers:SliverItemsControl.ItemTemplate>
                    </slivers:SliverItemsControl>
                  </ScrollViewer>
                </TabItem>
              </TabControl>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Mixed">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Mixed sliver composition" />
              <TextBlock Classes="muted" Text="A sample-only panel composes a pinned header, fixed rows, padded grid, and fill-remaining region through SliverViewportLayoutEngine." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
              <ItemsControl ItemsSource="{Binding Demos}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,4,0,0" Classes="muted" Text="{Binding FlutterReference}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <local:MixedSliverPreviewPanel CacheExtent="{Binding CacheExtent}">
                <Border Padding="18,10" Background="#172554" ClipToBounds="True" CornerRadius="8">
                  <StackPanel Spacing="2">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Text="CustomScrollView composition" />
                    <TextBlock FontSize="12" Foreground="#BFDBFE" Text="Pinned header, fixed rows, grid tiles, and fill remaining in one viewport." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="row-card"><TextBlock Text="Fixed extent row 01" /></Border>
                <Border Classes="row-card"><TextBlock Text="Fixed extent row 02" /></Border>
                <Border Classes="row-card"><TextBlock Text="Fixed extent row 03" /></Border>
                <Border Classes="row-card"><TextBlock Text="Fixed extent row 04" /></Border>
                <Border Classes="row-card"><TextBlock Text="Fixed extent row 05" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 01" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 02" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 03" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 04" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 05" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 06" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 07" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 08" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 09" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 10" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 11" /></Border>
                <Border Classes="tile-card"><TextBlock Text="Grid tile 12" /></Border>
                <Border Padding="18" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#064E3B" Text="Fill remaining" />
                    <TextBlock Foreground="#047857" Text="The core fills empty viewport space while preserving the sliver scroll model." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </local:MixedSliverPreviewPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Sections">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Sectioned list with sticky headers" />
              <TextBlock Classes="muted" Text="Avalonia-local projections flatten shared gallery sections into alternating pinned headers and row slivers." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Header mode" />
              <ComboBox
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding SectionHeaderModes}"
                  SelectedItem="{Binding SectionHeaderMode, Mode=TwoWay}" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding SectionedBlocks}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:SliverScenarioStackPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        SectionHeaderMode="{Binding $parent[Window].DataContext.SectionHeaderMode}" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="row-card">
                      <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="12">
                        <Border Background="{Binding AccentColor}" CornerRadius="3" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" Text="{Binding Kind}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Fill">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Fill, padding, visibility" />
              <TextBlock Classes="muted" Text="One-child-per-sliver blocks demonstrate SliverPadding, SliverToBoxAdapter, SliverVisibility, and SliverFillRemaining." TextWrapping="Wrap" />
              <CheckBox Content="Show visibility sliver" IsChecked="{Binding ShowOptionalSliver, Mode=TwoWay}" />
              <CheckBox Content="Maintain hidden size" IsChecked="{Binding MaintainOptionalSliverSize, Mode=TwoWay}" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="1200" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding CompositionBlocks}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:SliverScenarioStackPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        MaintainVisibilitySliverSize="{Binding $parent[Window].DataContext.MaintainOptionalSliverSize}"
                        ShowVisibilitySliver="{Binding $parent[Window].DataContext.ShowOptionalSliver}" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="tile-card">
                      <Grid RowDefinitions="Auto,*,Auto">
                        <Border Width="36" Height="4" HorizontalAlignment="Left" Background="{Binding AccentColor}" CornerRadius="2" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Kind}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Cache">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Cache performance stress" />
              <TextBlock Classes="muted" Text="A 100,000-row fixed-extent source exercises paint plus cache realization without materializing the full item source as controls." TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Rows" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="100,000" />
              <TextBlock Classes="muted" Text="Cache extent" />
              <Slider Minimum="0" Maximum="2000" Value="{Binding CacheExtent, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="viewport">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
              <slivers:SliverItemsControl ClipToBounds="True" ItemsSource="{Binding StressRows}">
                <slivers:SliverItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <slivers:SliverVirtualizingStackPanel
                        CacheExtent="{Binding $parent[Window].DataContext.CacheExtent}"
                        ItemExtent="50"
                        Spacing="4" />
                  </ItemsPanelTemplate>
                </slivers:SliverItemsControl.ItemsPanel>
                <slivers:SliverItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="row-card">
                      <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                        <Border Background="{Binding AccentColor}" CornerRadius="3" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" Text="{Binding Category}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </slivers:SliverItemsControl.ItemTemplate>
              </slivers:SliverItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
